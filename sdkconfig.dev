# DEVELOPMENT profile. NOT for distribution. No Secure Boot, no flash encryption, JTAG/UART open.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_MULTIKEY_ALLOW_EFUSE_PROVISIONING is not set
# Irreversible features stay OFF in development (see sdkconfig.hardening for production only).
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set
