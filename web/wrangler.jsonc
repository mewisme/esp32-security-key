{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "multikeys-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-23",
  // Production is reachable only through its custom domain: no *.workers.dev URL and no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Production custom domain: Cloudflare creates the DNS record and the certificate on deploy (the mewis.me zone must be on
  // the same account).
  "routes": [{ "pattern": "multikeys.mewis.me", "custom_domain": true }]
}
