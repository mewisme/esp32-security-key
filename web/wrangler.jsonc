{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "multikeys-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Production custom domain: Cloudflare creates the DNS record and the certificate on deploy (the mewis.me zone must be on
  // the same account). Staging sets its own empty routes so that it can never take the domain over.
  "routes": [{ "pattern": "multikeys.mewis.me", "custom_domain": true }],
  "env": {
    "staging": { "name": "multikeys-web-staging", "workers_dev": true, "routes": [] }
  }
}
