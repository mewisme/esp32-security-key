+        pin_derive_session(CONST_BYTE_ARRAY(new_pin, new_pin_len), new_session);
+        def[0] = 0x3; // Format
+        r = encrypt_with_aad(new_session, CONST_BYTE_ARRAY(plain, DEK_SIZE), PIN_KDF_DEFAULT_VERSION, def + 1);
+    }
+    if (r == PICOKEYS_OK) {
+        r = file_put_data(ef, CONST_BYTE_ARRAY(def, sizeof(def)));
+    }
+    mbedtls_platform_zeroize(plain, sizeof(plain));
+    mbedtls_platform_zeroize(def, sizeof(def));
+    return r;
