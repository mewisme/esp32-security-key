 #include "piv.h"
 
 
+/* PIV reset must only remove PIV state: the data pool is shared with OpenPGP and with the MKAUTH records. */
+static bool piv_reset_target(const file_t *file) {
+    if (!file) {
+        return false;
+    }
+    uint16_t fid = file->fid;
+    if (openpgp_key_container_physical_fid(fid)) {
+        uint8_t id = fid & UINT8_MAX;
+        return openpgp_key_container_is_piv(id) && id != EF_PIV_KEY_ATTESTATION;
+    }
+    /* The attestation key and its certificate identify the device; they survive a reset. */
+    if (fid == EF_PIV_KEY_ATTESTATION || fid == EF_PIV_ATTESTATION) {
+        return false;
+    }
+    if (openpgp_key_container_is_piv(fid)) {
+        return true;
+    }
+    return fid == EF_PIV_PIN || fid == EF_PIV_PUK || fid == EF_DEK_PWPIV || fid == EF_PIV_DISCOVERY || fid == EF_PIV_BITGT ||
+           (fid >= EF_PIV_ADMIN_DATA && fid <= EF_PIV_MSROOTS5) || (fid >= EF_PIV_CARD_AUTH && fid <= EF_PIV_PC_REF_DATA);
+}
+
+static bool piv_reset_note(file_delete_result_t result, int *status) {
+    if (result.value != PICOKEYS_OK) {
+        *status = result.value;
+        return false;
+    }
+    if (*status == PICOKEYS_OK && result.metadata != PICOKEYS_OK) {
+        *status = result.metadata;
+    }
+    return true;
+}
+
+static bool piv_reset_clear_dynamic(file_t *file, void *ctx) {
+    if (!piv_reset_target(file)) {
+        return true;
+    }
+    return piv_reset_note(file_delete_no_commit_parts(file), (int *)ctx);
+}
+
+static int piv_reset_retry_defaults(void) {
+    file_t *status = file_search_by_fid(EF_PW_PRIV, NULL, SPECIFY_EF);
+    file_t *retries = file_search_by_fid(EF_PW_RETRIES, NULL, SPECIFY_EF);
+    if (!file_has_data(status) || !file_has_data(retries)) {
+        return PICOKEYS_ERR_FILE_NOT_FOUND;
+    }
+    uint16_t status_len = file_get_size(status), retries_len = file_get_size(retries);
+    if (status_len < 9 || status_len > 64 || retries_len < 6 || retries_len > 64) {
+        return PICOKEYS_ERR_MEMORY_FATAL;
+    }
+    uint8_t buf[64];
+    memcpy(buf, file_get_data(status), status_len);
+    buf[3 + (EF_PIV_PIN & 0xf)] = 3;
+    buf[3 + (EF_PIV_PUK & 0xf)] = 3;
+    int r = file_put_data(status, CONST_BYTE_ARRAY(buf, status_len));
+    if (r != PICOKEYS_OK) {
+        return r;
+    }
+    memcpy(buf, file_get_data(retries), retries_len);
+    buf[EF_PIV_PIN & 0xf] = 3;
+    buf[EF_PIV_PUK & 0xf] = 3;
+    return file_put_data(retries, CONST_BYTE_ARRAY(buf, retries_len));
+}
+
 int cmd_reset(void) {
     if (P1(apdu) != 0x0 || P2(apdu) != 0x0) {
         return SW_INCORRECT_P1P2();
@@ -32,8 +95,33 @@ int cmd_reset(void) {
     if (retPIN != 0 || retPUK != 0) {
         return SW_INCORRECT_PARAMS();
     }
-    file_initialize_flash(true);
+    int status = PICOKEYS_OK;
