+        file_t *file = &entry->file;
+        if (file->fid == 0 || !piv_reset_target(file) || !(file_get_type(file) & FILE_DATA_FLASH)) {
+            continue;
+        }
+        piv_reset_note(file_delete_no_commit_parts(file), &status);
+    }
+    if (status == PICOKEYS_OK) {
+        file_for_each_dynamic(piv_reset_clear_dynamic, &status);
+    }
+    /* Slot metadata is keyed by key reference (0x82..0x95, the 0x96 alias of 0x93, and 0x9a..0x9e). */
+    for (uint16_t slot = EF_PIV_KEY_RETIRED1; slot <= EF_PIV_KEY_CARDAUTH && status == PICOKEYS_OK; slot++) {
+        if (slot < 0x97 || slot > 0x99) {
+            status = meta_delete_no_commit(slot);
+        }
+    }
     flash_commit();
+    file_initialize_flash(false);
+    has_pwpiv = false;
+    has_mgm = false;
+    mbedtls_platform_zeroize(session_pwpiv, sizeof(session_pwpiv));
+    release_dek();
     init_piv();
-    return SW_OK();
+    if (piv_reset_retry_defaults() != PICOKEYS_OK && status == PICOKEYS_OK) {
+        status = PICOKEYS_EXEC_ERROR;
