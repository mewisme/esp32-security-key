+/* Re-wrap the PIV DEK from the session of the current PIN to the one of new_pin. new_session receives the
+ * session derived from new_pin. Nothing is written unless the DEK was unwrapped and re-wrapped. */
+int piv_rewrap_dek(const uint8_t old_session[32], const uint8_t *new_pin, size_t new_pin_len, uint8_t new_session[32]) {
+    file_t *ef = file_search_by_fid(EF_DEK_PWPIV, NULL, SPECIFY_EF);
+    if (!ef || !file_has_data(ef) || file_get_size(ef) != DEK_FILE_SIZE || file_get_data(ef)[0] != 0x3) {
+        return PICOKEYS_ERR_FILE_NOT_FOUND;
