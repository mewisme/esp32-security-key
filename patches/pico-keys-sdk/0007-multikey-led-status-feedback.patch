diff --git a/src/led/led_status.h b/src/led/led_status.h
new file mode 100644
index 0000000..5acad6b
--- /dev/null
+++ b/src/led/led_status.h
@@ -0,0 +1,71 @@
+/*
+ * MultiKeys: pure LED feedback state machine (no hardware access, host-testable).
+ * Maps user-presence and job events to one transient feedback. Outcome feedback is only given for a job that
+ * asked for user presence and whose outcome was not already shown, so polling and PIN traffic stay silent.
+ */
+
+#ifndef _LED_STATUS_H_
+#define _LED_STATUS_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef enum {
+    LED_EV_UP_REQUEST,
+    LED_EV_UP_ACCEPTED,
+    LED_EV_UP_TIMEOUT,
+    LED_EV_UP_CANCELLED,
+    LED_EV_JOB_OK,
+    LED_EV_JOB_ERROR,
+    LED_EV_JOB_CANCELLED,
+    LED_EV_CHANNEL_RESET
+} led_status_event_t;
+
+typedef enum {
+    LED_FB_NONE,
+    LED_FB_CLEAR,
+    LED_FB_UP_ACCEPTED,
+    LED_FB_SUCCESS,
+    LED_FB_FAILURE,
+    LED_FB_TIMEOUT
+} led_feedback_t;
+
+typedef struct {
+    bool up_in_job;
+    bool outcome_shown;
+} led_status_t;
+
+static inline void led_status_init(led_status_t *s) {
+    s->up_in_job = false;
+    s->outcome_shown = false;
+}
+
+static inline led_feedback_t led_status_step(led_status_t *s, led_status_event_t ev) {
+    led_feedback_t fb = LED_FB_NONE;
+    switch (ev) {
+        case LED_EV_UP_REQUEST:
+            s->up_in_job = true;
+            s->outcome_shown = false;
+            return LED_FB_CLEAR;
+        case LED_EV_UP_ACCEPTED:
+            return LED_FB_UP_ACCEPTED;
+        case LED_EV_UP_TIMEOUT:
+            s->outcome_shown = true;
+            return LED_FB_TIMEOUT;
+        case LED_EV_UP_CANCELLED:
+        case LED_EV_JOB_CANCELLED:
+        case LED_EV_CHANNEL_RESET:
+            led_status_init(s);
+            return LED_FB_CLEAR;
+        case LED_EV_JOB_OK:
+        case LED_EV_JOB_ERROR:
+            if (s->up_in_job && !s->outcome_shown) {
+                fb = ev == LED_EV_JOB_OK ? LED_FB_SUCCESS : LED_FB_FAILURE;
+            }
+            led_status_init(s);
+            return fb;
+    }
+    return LED_FB_NONE;
+}
+
+#endif // _LED_STATUS_H_
