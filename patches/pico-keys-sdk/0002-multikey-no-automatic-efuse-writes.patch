 int otp_platform_enable_secure_boot(uint8_t bootkey, bool secure_lock) {
+    /* MultiKey: this path burns Secure Boot digests and JTAG fuses bound to the UPSTREAM project's
+     * boot key digest, triggered from the USB rescue interface. It is disabled: production hardening
+     * uses ESP-IDF's own Secure Boot v2 flow with the operator's key (docs/PROVISIONING.md). */
+    (void)bootkey;
+    (void)secure_lock;
+    printf("Secure boot provisioning through the rescue interface is disabled in MultiKey builds.\n");
+    return ESP_ERR_NOT_SUPPORTED;
+}
+
+/* Upstream implementation kept verbatim below to keep the patch small; intentionally unreferenced. */
+static __attribute__((unused)) int otp_platform_enable_secure_boot_upstream(uint8_t bootkey, bool secure_lock) {
     if (bootkey > 2) {
         return ESP_ERR_INVALID_ARG;
     }
@@ -283,7 +294,12 @@ int otp_platform_enable_secure_boot(uint8_t bootkey, bool secure_lock) {
     return PICOKEYS_OK;
 }
 
-void otp_platform_init(const uint8_t **otp_key_1_out, const uint8_t **otp_key_2_out) {
+/* MultiKey: upstream silently burns random MKEK keys into eFuse blocks KEY3/KEY4 on first boot.
+ * That is irreversible, so the code that does it is compiled in ONLY when the operator enables
+ * CONFIG_MULTIKEY_ALLOW_EFUSE_PROVISIONING (default off; see docs/PROVISIONING.md). Without it this
+ * function only reads eFuse blocks that are already programmed. */
+#ifdef CONFIG_MULTIKEY_ALLOW_EFUSE_PROVISIONING
+static void multikey_provision_otp_keys(void) {
     esp_err_t ret = 0;
     uint16_t write_otp[2] = {0xFFFF, 0xFFFF};
 
