+/* MultiKeys: repetition-count health test (NIST SP 800-90B 4.4.1, cutoff 4 identical consecutive 32-bit
+ * samples: a healthy source repeats that often with probability 2^-96). A stuck source makes the draw fail, so
+ * nothing from it is mixed into the pool and the pool keeps filling only from healthy samples. */
+#define HWRNG_RCT_CUTOFF 4
+static uint32_t rct_last = 0;
+static uint8_t rct_count = 0;
+static bool rct_valid = false;
+
+static bool hwrng_rct_accept(uint64_t word) {
+    for (int i = 0; i < 2; i++) {
+        uint32_t s = (uint32_t)(word >> (32 * i));
+        if (rct_valid && s == rct_last) {
+            if (++rct_count >= HWRNG_RCT_CUTOFF) {
+                return false;
+            }
+        }
+        else {
+            rct_last = s;
+            rct_count = 1;
+            rct_valid = true;
+        }
+    }
+    return true;
+}
