diff --git a/src/usb/usb.c b/src/usb/usb.c
index 91fdf11..afbf05e 100644
--- a/src/usb/usb.c
+++ b/src/usb/usb.c
@@ -243,12 +243,42 @@ bool is_busy(void) {
     return timeout > 0;
 }
 
+/* MultiKeys: request generation. Every command handed to the card thread (EV_CMD_AVAILABLE) starts a new
+ * generation. A job that the host cancelled stays in the card thread until it notices the cancel; its completion
+ * (EV_EXEC_FINISHED, finished_data_size, bytes written into the response buffer) belongs to that generation and
+ * must never be taken for the answer to a later request. The HID layer therefore marks the job abandoned,
+ * refuses new commands while any job is outstanding, and drops the completion of an abandoned job. */
+static volatile uint32_t card_job_generation = 0;
+static volatile uint32_t card_job_abandoned_generation = 0; /* 0: none */
+
+void card_job_abandon(void) {
+    if (timeout > 0) {
+        card_job_abandoned_generation = card_job_generation;
+    }
+}
+
+bool card_job_take_abandoned(void) {
+    if (card_job_abandoned_generation != 0 && card_job_abandoned_generation == card_job_generation) {
+        card_job_abandoned_generation = 0;
+        return true;
+    }
+    return false;
+}
+
+void card_job_reset(void) {
+    card_job_abandoned_generation = 0;
+    timeout_stop();
+}
+
 void usb_send_event(uint32_t flag) {
 #ifndef ENABLE_EMULATION
     mutex_enter_blocking(&mutex);
 #endif
     queue_add_blocking(&usb_to_card_q, &flag);
     if (flag == EV_CMD_AVAILABLE) {
+        if (++card_job_generation == 0) {
+            card_job_generation = 1;
+        }
         timeout_start();
     }
 #ifndef ENABLE_EMULATION
