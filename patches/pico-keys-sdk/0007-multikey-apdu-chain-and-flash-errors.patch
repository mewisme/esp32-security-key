MultiKeys 0007: APDU chaining overflow, flash error handling, GCM leak, pinned-dependency cache check.
- src/apdu.c, apdu.h, ccid.c, emulation.c: ported from upstream pico-keys-sdk 325c0a9 ('Fix chaining overflow'):
  chained commands are reassembled in chain_buf instead of memmoving into the transport buffer.
- src/fs/low_flash.c: ESP partition erase/program errors are reported (callers keep the data pending).
- src/crypto_utils.c: encrypt_with_aad/decrypt_with_aad free the GCM context when setkey fails; RNG failure checked.
- cmake/deps.cmake: a cached third-party clone must match the pinned commit and be clean.
- src/usb/emulation/emulation.h: USB_BUFFER_SIZE overridable so emulation can use the device value.

diff --git a/cmake/deps.cmake b/cmake/deps.cmake
index 7e8bbbf..19ffec0 100644
--- a/cmake/deps.cmake
+++ b/cmake/deps.cmake
@@ -60,6 +60,28 @@ function(picokeys_sync_dep name repo ref dest)
         endif()
         if(NOT _repo_ok OR NOT _ref_ok)
             set(_need_fetch ON)
+        elseif(EXISTS "${dest}/.git")
+            # MultiKeys: a marker file alone proves nothing (it survives a manual checkout or local edits).
+            # When the cache is a real clone, HEAD must equal the pinned commit and the tracked files must be
+            # clean; otherwise it is fetched again. Copies without .git (rsync'd build trees) keep trusting the
+            # marker.
+            execute_process(
+                COMMAND git -C ${dest} rev-parse HEAD
+                RESULT_VARIABLE _cache_head_rc
+                OUTPUT_VARIABLE _cache_head
+                OUTPUT_STRIP_TRAILING_WHITESPACE
+            )
+            execute_process(
+                COMMAND git -C ${dest} status --porcelain --untracked-files=no --ignore-submodules=all
+                RESULT_VARIABLE _cache_status_rc
+                OUTPUT_VARIABLE _cache_status
+                OUTPUT_STRIP_TRAILING_WHITESPACE
+            )
+            if(NOT _cache_head_rc EQUAL 0 OR NOT _cache_head STREQUAL "${ref}"
+               OR NOT _cache_status_rc EQUAL 0 OR NOT "${_cache_status}" STREQUAL "")
+                message(STATUS "[deps] ${name}: cached checkout does not match ${ref} or is modified")
+                set(_need_fetch ON)
+            endif()
         endif()
     endif()
 
