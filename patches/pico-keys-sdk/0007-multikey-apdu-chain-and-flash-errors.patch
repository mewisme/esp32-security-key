   #define restore_interrupts(a) (void)a
+  /* MultiKeys: the partition API results used to be dropped, so a failed erase/program was treated as done and
+   * the journal was marked complete over half-written data. The wrappers record the first failure of an
+   * operation; do_flash_op_*() reads it with FLASH_OP_FAILED() and reports the operation as not performed. */
+  static esp_err_t flash_op_err = ESP_OK;
+  static inline void flash_range_erase(uintptr_t addr, size_t size) {
+      esp_err_t err = esp_partition_erase_range(part0, addr, size);
+      if (err != ESP_OK && flash_op_err == ESP_OK) {
+          flash_op_err = err;
+      }
+  }
+  static inline void flash_range_program(uintptr_t addr, const uint8_t *data, size_t size) {
+      esp_err_t err = esp_partition_write(part0, addr, data, size);
+      if (err != ESP_OK && flash_op_err == ESP_OK) {
+          flash_op_err = err;
+      }
+  }
+  #define FLASH_OP_BEGIN() (flash_op_err = ESP_OK)
+  #define FLASH_OP_FAILED() (flash_op_err != ESP_OK)
  #else
