                 case VENDOR_REQUEST_WEBUSB:
-                    return tud_control_xfer(rhport, request, (void*)(uintptr_t) &desc_url, desc_url.bLength);
+#if CONFIG_MULTIKEY_WEBUSB_LANDING_ENABLED
+                    /* WebUSB GET_URL: wIndex 2, wValue = iLandingPage (1). Anything else stalls. */
+                    if (request->wIndex == 2 && request->wValue == 1 && desc_url[0] > 3) {
+                        return tud_control_xfer(rhport, request, (void*)(uintptr_t) desc_url, desc_url[0]);
+                    }
+#endif
+                    return false;
 
                 case VENDOR_REQUEST_MICROSOFT:
                     if (request->wIndex == 7) {
@@ -334,9 +371,11 @@ bool tud_vendor_control_xfer_cb(uint8_t rhport, uint8_t stage, tusb_control_requ
 
 uint8_t const desc_bos[] = {
     // total length, number of device caps
