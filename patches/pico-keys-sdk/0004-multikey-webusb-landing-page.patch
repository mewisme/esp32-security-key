@@ -239,16 +249,37 @@ enum
   VENDOR_REQUEST_WEBUSB = 1,
   VENDOR_REQUEST_MICROSOFT = 2
 };
-#define URL  "www.picokeys.com"
+#if CONFIG_MULTIKEY_WEBUSB_LANDING_ENABLED
+/* MultiKey: WebUSB landing page. The Kconfig value is a full https:// URL; the descriptor carries the
+   scheme as bScheme=1 and only the remainder as bytes, so it is assembled once at boot. CMake validates
+   the URL (https, printable ASCII, 1..200 characters after the scheme). */
+#ifndef CONFIG_MULTIKEY_WEBUSB_LANDING_URL
+#define CONFIG_MULTIKEY_WEBUSB_LANDING_URL "https://www.picokeys.com"
+#endif
+#define MK_URL_SCHEME "https://"
+#define MK_URL_MAX 200
+_Static_assert(sizeof(CONFIG_MULTIKEY_WEBUSB_LANDING_URL) > sizeof(MK_URL_SCHEME) &&
+               sizeof(CONFIG_MULTIKEY_WEBUSB_LANDING_URL) - sizeof(MK_URL_SCHEME) <= MK_URL_MAX,
+               "MULTIKEY_WEBUSB_LANDING_URL must be https:// plus 1..200 characters");
+_Static_assert(sizeof(MK_URL_SCHEME) == 9, "scheme length");
+#endif
 static bool web_serial_connected = false;
 
-const tusb_desc_webusb_url_t desc_url =
-{
-  .bLength         = 3 + sizeof(URL) - 1,
-  .bDescriptorType = 3, // WEBUSB URL type
-  .bScheme         = 1, // 0: http, 1: https
-  .url             = URL
-};
+#if CONFIG_MULTIKEY_WEBUSB_LANDING_ENABLED
+static uint8_t desc_url[3 + MK_URL_MAX];
+
+static void multikey_webusb_url_init(void) {
+    const char *full = CONFIG_MULTIKEY_WEBUSB_LANDING_URL;
+    size_t n = sizeof(CONFIG_MULTIKEY_WEBUSB_LANDING_URL) - 1 - (sizeof(MK_URL_SCHEME) - 1);
+    if (strncmp(full, MK_URL_SCHEME, sizeof(MK_URL_SCHEME) - 1) != 0) {
+        n = 0; /* not https: advertise nothing rather than a wrong URL */
+    }
+    desc_url[0] = (uint8_t)(3 + n);
+    desc_url[1] = 3; /* WEBUSB URL type */
+    desc_url[2] = 1; /* 0: http, 1: https */
+    memcpy(&desc_url[3], full + sizeof(MK_URL_SCHEME) - 1, n);
+}
+#endif
 
 uint8_t desc_ms_os_20[] = {
   // Set header: length, type, windows version, total length
@@ -295,7 +326,13 @@ bool tud_vendor_control_xfer_cb(uint8_t rhport, uint8_t stage, tusb_control_requ
         case TUSB_REQ_TYPE_VENDOR:
