diff --git a/src/fido/fido.c b/src/fido/fido.c
index aeccba9..a9fd22e 100644
--- a/src/fido/fido.c
+++ b/src/fido/fido.c
@@ -300,6 +300,16 @@ int load_keydev(uint8_t key[32]) {
     return PICOKEYS_OK;
 }
 
+/* MultiKeys: true when the device key can be unwrapped right now. False while the key is PIN-wrapped and the PIN
+ * has not been entered since power-up. Callers must refuse to sign or to create credentials in that state:
+ * upstream ignored the failure and carried on with an all-zero key. */
+bool fido_keydev_available(void) {
+    uint8_t key[32] = { 0 };
+    int ret = load_keydev(key);
+    mbedtls_platform_zeroize(key, sizeof(key));
+    return ret == PICOKEYS_OK;
+}
